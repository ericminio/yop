{
    "name": "yop",
    "version": "0.1.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ericminio/yop.git"
    },
    "private": false,
    "type": "module",
    "devDependencies": {
        "@stryker-mutator/core": "^8.2.6",
        "jsdom": "^22.0.0",
        "playwright": "^1.40.0",
        "prettier": "2.8.4",
        "selenium-webdriver": "^4.14.0"
    },
    "scripts": {
        "test": "node --test --experimental-test-coverage --test-coverage-exclude '**/*.html' --test-coverage-exclude '**/*.test.js' $(find about brag -name '*.test.js')",
        "test:hexagonal-coverage": "node --test --experimental-test-coverage --test-coverage-exclude 'dist/**/*' $(find brag/10.hexagonal -name '*.test.js')",
        "test:hexagonal": "node --test $(find brag/10.hexagonal -name '*.test.js')",
        "test:hexagonal-about": "node --test $(find brag/10.hexagonal/about -name '*.test.js')",
        "test:hexagonal-domain": "node --test $(find brag/10.hexagonal/app/domain -name '*.test.js')",
        "test:hexagonal-components": "node --test $(find brag/10.hexagonal/app/web -name '*.test.js')",
        "stryker:hexagonal": "stryker run",
        "start:hexagonal": "node brag/10.hexagonal/app/start.mjs",
        "prettier:check": "npx prettier --check .",
        "prettier:write": "npx prettier --write .",
        "nodemon": "nodemon --watch brag/8.timer/app -e js,mjs,cjs,json,html brag/8.timer/app/start.mjs"
    },
    "dependencies": {
        "nodemon": "^3.0.1",
        "pg": "^8.11.0"
    }
}
